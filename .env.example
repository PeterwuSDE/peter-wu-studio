# Private Vercel Blob store on the existing project. Do not use a public store.
# On Vercel, connecting the store can inject these. Leave them unset locally
# and the inquiry API will refuse to save rather than report success.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Resend (free tier). Leave the key unset to keep delivery unconfigured.
# onboarding@resend.dev only delivers to the address that owns the Resend account
# until a domain is verified. Default recipient is northlinestudio425@gmail.com.
RESEND_API_KEY=
SEO_NOTIFY_TO=northlinestudio425@gmail.com
SEO_NOTIFY_FROM=Northline Studio <onboarding@resend.dev>

# Required before POST /api/seo-inquiry-retries will run. Vercel Cron sends CRON_SECRET.
SEO_INQUIRY_RETRY_TOKEN=
CRON_SECRET=

# Optional. Retention defaults to 90 days. New inquiries default to 10 per IP per hour.
SEO_INQUIRY_RETENTION_DAYS=90
SEO_INQUIRY_RATE_LIMIT_PER_HOUR=10
# Extra browser origins, comma-separated. Production and localhost are always allowed.
SEO_INQUIRY_ALLOWED_ORIGINS=
