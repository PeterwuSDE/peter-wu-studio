{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run export:static",
  "outputDirectory": "dist/client",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/mac-mini",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mac-mini/",
      "destination": "/",
      "permanent": true
    }
  ]
}
